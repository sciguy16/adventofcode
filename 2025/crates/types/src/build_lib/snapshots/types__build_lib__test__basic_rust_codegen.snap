// THIS FILE IS AUTOMATICALLY GENERATED, DO NOT EDIT


#[doc = "Top-level packets, e.g. ping/pong"]
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Top {}
impl crate::Destination for Top {
    const ID: u8 = 0;
    const NAME: &'static str = "top";
    type Types = top::Types;
}

pub mod top {
    use crate::{Destination, Header, Type};
    use color_eyre::eyre::eyre;
    use std::io::{Read, Write};

    #[derive(Clone, Debug, PartialEq, Eq)]
    pub struct Ping {
        pub data: u32,
    }

    impl crate::Type for Ping {
        const ID: u8 = 0;
        const NAME: &str = "ping";
        const REPLY_TO: Option<&str> = None;
    }

    impl crate::SerDe for Ping {
        fn serialise(&self, buf: &mut [u8]) -> crate::Result<usize> {
            let mut cur = std::io::Cursor::new(buf);

            cur.write_all(&self.data.to_be_bytes())?;

            Ok(cur.position().try_into()?)
        }

        fn deserialise(buf: &[u8]) -> crate::Result<Self> {
            let mut cur = std::io::Cursor::new(buf);

            let mut data = [0; 4];
            cur.read_exact(&mut data)?;
            let data = u32::from_be_bytes(data);


            Ok(Self {
                data,
            })
        }
    }

    #[derive(Clone, Debug, PartialEq, Eq)]
    pub enum Types {
        Ping(Ping),
    }

    impl Types {
        pub const fn id(&self) -> u8 {
            match self {
                Self::Ping(_) => Ping::ID,
            }
        }
    }

    impl crate::SerDe for Types {
        fn serialise(&self, buf: &mut [u8]) -> crate::Result<usize> {
            // skip header, then write full payload, then go back and
            // write header with correct length

            if buf.len() < 8 {
                return Err(eyre!("Buffer too short"));
            }

            let written_len = match self {
                Self::Ping(inner) =>
                    inner.serialise(&mut buf[4..])?,
            };

            let header = Header {
                destination: super::Top::ID,
                ty: self.id(),
                len: written_len.try_into()?,
            };
            buf[..4].copy_from_slice(&<[u8; 4]>::from(header));

            Ok(written_len+4)
        }

        fn deserialise(buf: &[u8]) -> crate::Result<Self> {
            if buf.len() < 8 {
                return Err(eyre!("Buffer too short"));
            }

            let header: [u8; 4] = buf[..4].try_into().unwrap();
            let header = Header::from(header);

            if buf.len()  < usize::from(header.len) + 4 {
                return Err(eyre!("Buffer too short"));
            }

            match header.ty {
                0 => {
                    let inner = Ping::deserialise(&buf[4..])?;
                    Ok(Self::Ping(inner))
                }
                other => Err(eyre!("Invalid type `{other:02x}")),
            }
        }
    }


    impl From<Ping> for Types {
        fn from(inner: Ping) -> Self {
            Self::Ping(inner)
        }
    }

    impl PartialEq<Ping> for Types {
        fn eq(&self, rhs: &Ping) -> bool {
            if let Self::Ping(inner) = &self {
                inner == rhs
            } else {
                false
            }
        }
    }

}
